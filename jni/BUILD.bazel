# jni/BUILD.bazel
#
# Builds libagentflow_jni.so — the JNI shared library that the Kotlin/JVM
# layer loads via System.loadLibrary("agentflow_jni"). Pulls in all the
# C++ agentflow surface needed for the MVP runAgent + runJsonWorkflow paths.

load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "libagentflow_jni.so",
    srcs = ["agentflow_jni.cc"],
    linkshared = True,
    # `-z,notext` PERMITS text relocations. On the host (GNU ld) the combined
    # archive carries no real .text relocs, so the flag is a harmless belt.
    # On the NDK/arm64 cross-build it is actively harmful: it silently lets
    # real runtime text relocations through, producing a .so with DT_TEXTREL
    # that Android's loader REJECTS ("dlopen failed: ... has text relocations").
    # So we DROP it for android and let lld ENFORCE no-textrel (it will error
    # and name any offending object instead of shipping an unloadable .so).
    # Kept ONLY for the host config where it is benign.
    linkopts = select({
        "//bazel/platforms:is_android": [],
        "//conditions:default": ["-Wl,-z,notext"],
    }),
    deps = [
        # Official JNI headers. Bazel auto-detects the system JDK (via JAVA_HOME
        # or `java` on PATH) and materializes @local_jdk locally — no network,
        # no rules_java entry in MODULE.bazel needed on Bazel 7.
        "@bazel_tools//tools/jdk:jni",
        "//agentflow/core",
        "//agentflow/inference",
        "//agentflow/nodes",
        "//agentflow/tools",
        "//agentflow/workflow:workflow",
        "//agentflow/workflow:workflow_loader",
        "//agentflow/workflow:workflow_runner",
        "//proto:agentflow_proto",
        "@asio",
    ] + select({
        # @bazel_tools//tools/jdk:jni only exposes jni_md.h for os:linux target
        # platforms; cross-compiling for os:android needs this shim so jni.h's
        # `#include "jni_md.h"` resolves. See bazel/toolchains:android_jni_md.
        "//bazel/platforms:is_android": ["//bazel/toolchains:android_jni_md"],
        "//conditions:default": [],
    }),
)

# Device smoke check: dlopens libagentflow_jni.so on a real arm64 device and
# verifies every Kotlin-facing entry point resolves. A clean cross-compile
# proves neither — Android's loader rejects text relocations, and unresolved
# symbols only surface at dlopen. See device_load_check.cc for the run recipe.
cc_binary(
    name = "device_load_check",
    srcs = ["device_load_check.cc"],
    linkopts = ["-ldl"],
)
