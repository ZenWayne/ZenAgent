# .bazelrc
build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build --features=layering_check

# Sanitizers
build:asan --copt=-fsanitize=address --linkopt=-fsanitize=address
build:ubsan --copt=-fsanitize=undefined --linkopt=-fsanitize=undefined

# Test output
test --test_output=errors

# ── Android NDK / JDK toolchain registration ─────────────────────────
#
# MODULE.bazel deliberately does NOT register these eagerly:
# register_toolchains() is eager — it makes bazel resolve @androidndk for
# EVERY build, so a host-only server build would still require a real NDK
# on disk (and CI would too). use_repo() alone does not evaluate the
# extension. The android toolchains live under --config=android instead;
# default / host builds never touch the NDK.
#
# Order mirrors the old MODULE.bazel block: NDK toolchains first, then the
# JDK runtime toolchain registered LAST so host builds keep using the stock
# @local_jdk runtime (only the android target, which the stock one rejects,
# falls through to this one). See bazel/toolchains/BUILD.bazel.
#
# ANDROID_NDK_HOME must be exported in the build shell (NDK r26d).
build:android --extra_toolchains=@androidndk//:all
build:android --extra_toolchains=//bazel/toolchains:android_jdk_runtime_toolchain

# Android arm64-v8a cross-compile (on-device inference).
build:android_arm64 --platforms=//bazel/platforms:android_arm64
build:android_arm64 --android_platforms=//bazel/platforms:android_arm64
build:android_arm64 --copt=-DANDROID --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
# abseil exposes its headers via the bare repo-root, which Bazel passes as
# `-iquote external/abseil-cpp~`. The host compiler is gcc, which resolves
# `#include <absl/...>` from a quote dir; the NDK compiler is clang, which is
# strict and only searches quote dirs for `"..."` includes. Re-add the abseil
# repo root as an angle-searchable `-I` so `<absl/...>` resolves under clang.
# (The repo-root name is the Bazel 7 bzlmod canonical form pinned via
# .bazelversion; abseil-cpp is pinned in MODULE.bazel.)
build:android_arm64 --copt=-Iexternal/abseil-cpp~
# Inherit --config=android so the NDK / android JDK toolchains registered
# there are present for android-platform builds (build_jni_arm64.sh passes
# --config=android_arm64 alone).
build:android_arm64 --config=android

# On-device test executables (adb push + run on a real arm64 device).
#
# Inherits android_arm64 and adds the C++ runtime explicitly. Bazel links with
# the `clang` driver, not `clang++`, so nothing pulls in libc++ — a cc_binary
# with linkshared=True (our JNI .so) is unaffected because its symbols resolve
# at dlopen time, but every cc_test executable fails to link with undefined
# operator new / std::__ndk1::basic_string::~basic_string / operator delete.
#
# Kept as a SEPARATE config rather than folded into android_arm64: adding
# -lc++_static there would also statically link libc++ into libagentflow_jni.so,
# changing how the shipping artifact is built. Testing must not silently alter
# the deliverable.
#
#   bazel build --config=android_arm64_test //tests/unit/net:http_parse_test
build:android_arm64_test --config=android_arm64
build:android_arm64_test --linkopt=-lc++_static --linkopt=-lc++abi
# Static-link the project's own libraries too. Bazel otherwise emits cc_library
# as .so files that the test binary needs at runtime, and a bare `adb push` of
# the executable then dies with:
#   CANNOT LINK EXECUTABLE: library "libagentflow_Snet_Slibhttp_Uparse.so" not found
# One self-contained binary is what `adb push && run` actually wants.
build:android_arm64_test --dynamic_mode=off
