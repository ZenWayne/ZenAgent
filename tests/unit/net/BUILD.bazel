# tests/unit/net/BUILD.bazel
load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "tls_probe_test",
    size = "small",
    srcs = ["tls_probe_test.cc"],
    deps = [
        "@asio",
        "@boringssl//:crypto",
        "@boringssl//:ssl",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "http_parse_test",
    size = "small",
    srcs = ["http_parse_test.cc"],
    deps = [
        "//agentflow/net:http_parse",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "https_client_integration_test",
    # "medium" (not "small") because the live tests hit a real chat model
    # (e.g. Ollama gemma4:e2b) which can have a slow cold start.
    size = "medium",
    srcs = ["https_client_integration_test.cc"],
    deps = [
        "//agentflow/core",
        "//agentflow/net:https_client",
        "@abseil-cpp//absl/status:statusor",
        "@asio",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)
