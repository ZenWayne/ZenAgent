# tests/integration/tools/BUILD.bazel
load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "stdio_mcp_smoke_test",
    size = "medium",
    srcs = ["stdio_mcp_smoke_test.cc"],
    data = ["echo_mcp_server.py"],
    deps = [
        "//agentflow/core",
        "//agentflow/tools",
        "//proto:agentflow_proto",
        "@asio",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
