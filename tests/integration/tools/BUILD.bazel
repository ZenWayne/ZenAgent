# Manual acceptance test against a REAL video-maker MCP server. Skips itself
# unless MCP_LIVE_URL is set, and is tagged "manual" so it never joins the
# default `bazel test //tests/...` set (it needs a live external service and
# must never run unattended). See live_mcp_manual_test.cc for the read-only
# contract this test enforces.
cc_test(
    name = "live_mcp_manual_test",
    size = "medium",
    srcs = ["live_mcp_manual_test.cc"],
    # Without this the test cannot see MCP_LIVE_URL from the invoking shell, so
    # it GTEST_SKIPs -- and a skipped gtest still exits 0, which bazel reports as
    # PASSED. That is a green light that verified nothing. Inheriting the vars
    # makes `MCP_LIVE_URL=... bazel test //...:live_mcp_manual_test` do what it
    # obviously looks like it does.
    env_inherit = [
        "MCP_LIVE_BEARER",
        "MCP_LIVE_URL",
    ],
    tags = ["manual"],
    deps = [
        "//agentflow/core",
        "//agentflow/tools",
        "//proto:agentflow_proto",
        "@asio",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)
