# tests/repro/BUILD.bazel
load("@rules_cc//cc:defs.bzl", "cc_binary")

# Manual repro driver for docs/litert-lm-multi-session-teardown-bug.md. Needs a
# real .litertlm model (MODEL_PATH), so it is never part of `bazel test //...`.
cc_binary(
    name = "multi_session_teardown",
    testonly = True,
    srcs = ["multi_session_teardown.cc"],
    tags = ["manual"],
    deps = [
        "//agentflow/inference",
        "//third_party/litert_lm:c_engine",
    ],
)
