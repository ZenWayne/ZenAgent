load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Kept separate from //agentflow/core so clients without skills do not link yaml-cpp.
cc_library(
    name = "skills",
    srcs = ["skill.cc", "skill_library.cc", "skill_tools.cc"],
    hdrs = ["skill.h", "skill_library.h", "skill_script_runner.h", "skill_tools.h"],
    deps = [
        "//agentflow/core",
        "//agentflow/tools",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@asio",
        "@nlohmann_json//:json",
        "@yaml-cpp//:yaml-cpp",
    ],
)
