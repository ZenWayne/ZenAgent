# agentflow/nodes/BUILD.bazel
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "nodes",
    srcs = [
        "agent_node.cc",
        "aggregator_node.cc",
        "llm_node.cc",
        "router_node.cc",
        "team_node.cc",
    ],
    hdrs = [
        "agent_node.h",
        "aggregator_node.h",
        "llm_node.h",
        "router_node.h",
        "team_node.h",
    ],
    deps = [
        "//agentflow/core",
        # NOTE: llm_node.cc still needs the full //agentflow/inference target
        # (litert_lm_engine.h, litert_lm_session.h, c/engine.h) until Task 6
        # migrates it onto IChatBackend, so it stays alongside the two seam
        # targets agent_node.cc now needs directly (layering_check).
        "//agentflow/inference",
        "//agentflow/inference:canonical_message",
        "//agentflow/inference:chat_backend",
        "//agentflow/tools",
        "@abseil-cpp//absl/status",
        "@asio",
        "@nlohmann_json//:json",
    ],
)
