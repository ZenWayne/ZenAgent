cc_library(
    name = "workflow_loader",
    srcs = ["workflow_loader.cc"],
    hdrs = ["workflow_loader.h"],
    deps = [
        ":hmac_sha256",
        ":template_engine",
        ":workflow",
        "//agentflow/core",
        "//agentflow/tools",
        "//proto:agentflow_proto",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@nlohmann_json//:json",
    ],
)
