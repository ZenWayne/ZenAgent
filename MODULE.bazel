module(name = "agentflow", version = "0.1.0")

# ── Dependencies (Bazel Central Registry) ──────────────────────────
# Versions bumped from plan defaults to match what BCR currently serves
# (BCR pruned the original pins). Major lines preserved where possible.
bazel_dep(name = "rules_cc", version = "0.2.13")
bazel_dep(name = "rules_proto", version = "6.0.0")
bazel_dep(name = "protobuf", version = "30.1", repo_name = "com_google_protobuf")

# Override protobuf to v31.1 (not yet in BCR) so both our //proto-generated code
# AND the prebuilt LiteRT-LM combined archive use the SAME protobuf runtime.
# Without this, descriptor structs from 30.1 are interpreted by 31.1 method
# code under --allow-multiple-definition → reflection segfaults.
git_override(
    module_name = "protobuf",
    remote = "https://github.com/protocolbuffers/protobuf.git",
    commit = "74211c0dfc2777318ab53c2cd2c317a2ef9012de",  # v31.1
)
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "abseil-cpp", version = "20260526.0")  # match LiteRT-LM 90f42140's abseil (lts_20260526 inline ns)
# BCR's abseil-cpp@20260526.0 carries no compatibility_level (implicit 0) while
# protobuf's graph requires compat 1, and Bazel's single_version_override has no
# compat parameter — serve a wrapper-registry entry that declares compat 1.
single_version_override(
    module_name = "abseil-cpp",
    version = "20260526.0",
    registry = "file:///home/wayne/tools/zen/.bcr-override",
)
bazel_dep(name = "nlohmann_json", version = "3.11.3")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
# BoringSSL provides HMAC-SHA256 + SHA-256 for workflow signing (Spec §9.4).
# Replaces the prior vendored impl with a maintained, audited crypto lib.
bazel_dep(name = "boringssl", version = "0.20260526.0")

# ── asio (header-only, not in BCR — use http_archive) ─────────────
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_archive(
    name = "asio",
    build_file_content = """
cc_library(
    name = "asio",
    hdrs = glob([
        "asio/include/**/*.hpp",
        "asio/include/**/*.ipp",
    ]),
    includes = ["asio/include"],
    defines = [
        "ASIO_STANDALONE",
        "ASIO_NO_DEPRECATED",
    ],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "755bd7f85a4b269c67ae0ea254907c078d408cce8e1a352ad2ed664d233780e8",
    strip_prefix = "asio-asio-1-30-2",
    urls = ["https://github.com/chriskohlhoff/asio/archive/refs/tags/asio-1-30-2.tar.gz"],
)

# ── kissfft (built from source, NOT the machine-built .so) ────────
# The LiteRT-LM prebuilt archives need exactly two symbols from it
# (kiss_fftr, kiss_fftr_alloc — verified with nm --undefined-only), so only
# kiss_fft.c + kiss_fftr.c are compiled. Statically linked, which also means the
# runtime image no longer has to ship libkissfft-float.so.131.
#
# Default scalar type is float (kiss_fft.h: kiss_fft_scalar falls back to float
# when FIXED_POINT/USE_SIMD are undefined), matching the "-float" build the
# archives were compiled against. sha256 pinned so this is reproducible in CI.
http_archive(
    name = "kissfft",
    build_file_content = """
cc_library(
    name = "kissfft",
    srcs = [
        "kiss_fft.c",
        "kiss_fftr.c",
    ],
    hdrs = [
        "_kiss_fft_guts.h",
        "kiss_fft.h",
        "kiss_fft_log.h",
        "kiss_fftr.h",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "76c1aac87ddb7258f34b08a13f0eebf9e53afa299857568346aa5c82bcafaf1a",
    strip_prefix = "kissfft-131.1.0",
    urls = ["https://github.com/mborgerding/kissfft/archive/refs/tags/131.1.0.tar.gz"],
)

# ── LiteRT-LM prebuilt archives (host x86_64) ─────────────────────
# Output of an out-of-tree LiteRT-LM CMake build, re-aggregated by
# third_party/litert_lm/scripts/split_archives.sh. Unlike kissfft these cannot
# be compiled from source here — it is the whole TFLite/XNNPACK/sentencepiece
# stack — so they are fetched from a pinned release instead.
#
# Previously they lived in a gitignored lib/ and existed only on machines that
# had run that CMake build, which made every clean checkout (and CI) fail at
# cc_import. sha256 pinning makes the fetch reproducible.
#
# Rebuilt them? Upload to a new release tag and update BOTH url and sha256.
http_file(
    name = "litert_ce_staging",
    downloaded_file_path = "libce_staging.a",
    sha256 = "680d3e64f4abb33bae3278caa7da0787b5ad27303e9e69702ebd179cb918c00b",
    urls = ["https://github.com/ZenWayne/ZenAgent/releases/download/litert-lm-prebuilt-20260831/libce_staging.a"],
)

http_file(
    name = "litert_ce_external",
    downloaded_file_path = "libce_external.a",
    sha256 = "74de2728592f2f3449957c46a4d22ea30f83938986af0ac8079fb934680ebcd4",
    urls = ["https://github.com/ZenWayne/ZenAgent/releases/download/litert-lm-prebuilt-20260831/libce_external.a"],
)

# ── LiteRT-LM prebuilt archives (Android arm64-v8a) ────────────────
# Same split recipe as the host pair, cross-compiled from LiteRT-LM@90f42140
# (LLGuidance port, fork bf6197c9 + fix/ndk-r28b-preset) with NDK r28b via the
# android-arm64 preset. kissfft needs no arm64 prebuilt — the Bazel
# target compiles it from @kissfft source for android too.
#
# Rebuilt them? Upload to a new release tag and update BOTH url and sha256.
http_file(
    name = "litert_ce_staging_arm64",
    downloaded_file_path = "libce_staging.a",
    sha256 = "52ed0746398bdcff6855fdc81d481bbd6ca1e1f3a3845534dd3457f40a2b4d70",
    urls = ["https://github.com/ZenWayne/ZenAgent/releases/download/litert-lm-prebuilt-arm64-20260902/libce_staging.a"],
)

http_file(
    name = "litert_ce_external_arm64",
    downloaded_file_path = "libce_external.a",
    sha256 = "b3a3891d7185e802c915ecd9204b7bca44c885e089e1b88aff19785933933726",
    urls = ["https://github.com/ZenWayne/ZenAgent/releases/download/litert-lm-prebuilt-arm64-20260902/libce_external.a"],
)

# ── LiteRT-LM (header-only stub) ──────────────────────────────────
# Referenced as //third_party/litert_lm:c_engine (main workspace target).
# Upgrade to @litert_lm//:c_engine with local_path_override in MODULE.bazel
# when a prebuilt libc_engine.a is available.

# ── Android NDK toolchain (arm64-v8a on-device builds) ─────────────
# ANDROID_NDK_HOME must be exported in the build shell (NDK r28b - archive requires libc++19 ABI).
bazel_dep(name = "rules_android_ndk", version = "0.1.3")
android_ndk_repository_extension = use_extension(
    "@rules_android_ndk//:extension.bzl",
    "android_ndk_repository_extension",
)
use_repo(android_ndk_repository_extension, "androidndk")
# NOT registered here on purpose. register_toolchains() is eager — it makes
# bazel resolve @androidndk for every build, so a host-only server build would
# still require a real NDK on disk (and CI would need one too). The android
# toolchains are registered via --extra_toolchains under `--config=android`
# instead; see .bazelrc. use_repo() alone does not evaluate the extension.
# register_toolchains("@androidndk//:all")

# JDK runtime toolchain compatible with the android target platform, so that
# @bazel_tools//tools/jdk:jni (a dep of //jni:libagentflow_jni.so) can resolve
# a Java runtime when cross-compiling. Registered last so host builds keep
# using the stock @local_jdk runtime toolchain. See bazel/toolchains/BUILD.bazel.
# Registered under --config=android too (see .bazelrc) — same reason as above.
# register_toolchains("//bazel/toolchains:android_jdk_runtime_toolchain")

# ── Kotlin + JVM deps (dynamic schema / Wire codegen) ─────────────
bazel_dep(name = "rules_kotlin", version = "1.9.6")

# rules_kotlin@1.9.6 already pulls in rules_jvm_external@6.7 transitively;
# declare it explicitly so we can use the maven extension directly.
bazel_dep(name = "rules_jvm_external", version = "6.7")
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "agentflow_maven",
    artifacts = [
        "com.squareup.wire:wire-schema:4.9.9",
        "com.squareup.wire:wire-schema-jvm:4.9.9",
        "com.squareup.okio:okio:3.9.0",
        "com.squareup.okio:okio-fakefilesystem:3.9.0",
        "com.google.protobuf:protobuf-java:4.31.1",
        "junit:junit:4.13.2",
    ],
)
use_repo(maven, "agentflow_maven")
