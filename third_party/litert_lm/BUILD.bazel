# third_party/litert_lm/BUILD.bazel
package(default_visibility = ["//visibility:public"])

# Under --config=android_arm64 (//bazel/platforms:android_arm64) the prebuilt
# archives come from lib/arm64-v8a/ (Task 1 cross-compiled them with NDK r26d).
# The host (x86_64) build keeps using lib/*.a (the //conditions:default path).
config_setting(
    name = "android_build",
    constraint_values = ["@platforms//os:android"],
)

# kissfft used to be a machine-built .so dropped into lib/ (gitignored), which
# made a clean checkout unbuildable. It is now compiled from pinned source —
# see @kissfft in MODULE.bazel. Linked statically, so nothing has to ship it at
# runtime, and the arm64-v8a variant comes from the same source via bazel's
# cross-compilation rather than a second prebuilt.
alias(
    name = "kissfft",
    actual = "@kissfft//:kissfft",
)

# Prebuilt LiteRT-LM C engine, split into two archives that mirror how
# litert_lm_main links (built out-of-tree via CMake, see /.litert_build; .a's
# gitignored, machine-built). abseil objects are excluded from both — the
# binary's abseil comes from Bazel (@abseil-cpp pinned to 20260107 to match the
# lts_2026010712 inline namespace LiteRT-LM was compiled against).
#
# Staging = the litert_lm component libs, whole-archived (alwayslink) so static
# registrars survive (LITERT_LM_REGISTER_ENGINE etc.).
# NOTE: the arm64-v8a variants were never published — lib/arm64-v8a/ does not
# exist in a clean checkout, so --config=android has been broken independently
# of this change. Publish those archives and add http_file entries alongside the
# host ones to fix it.
cc_import(
    name = "c_engine_staging",
    static_library = select({
        ":android_build": "lib/arm64-v8a/libce_staging.a",
        "//conditions:default": "@litert_ce_staging//file:libce_staging.a",
    }),
    alwayslink = True,
)

# Externals (litert/tflite/protobuf/...) linked NORMALLY (no alwayslink).
# Whole-archiving these force-includes a bogus weak `R kLiteRtRuntimeBuiltin`
# (nullptr) from liblitert_cc_internal_extra that, under
# --allow-multiple-definition, would win over the real `D` def and crash
# litert::Environment::Create. On-demand linking pulls the real def first.
cc_import(
    name = "c_engine_external",
    static_library = select({
        ":android_build": "lib/arm64-v8a/libce_external.a",
        "//conditions:default": "@litert_ce_external//file:libce_external.a",
    }),
)

cc_library(
    name = "c_engine",
    hdrs = ["include/c/engine.h"],
    includes = ["include"],
    linkopts = [
        # The combined archive bundles LiteRT-LM's own abseil/protobuf, which
        # collide with Bazel's copies (via //proto, @com_google_protobuf).
        # Upstream litert_lm_main links with this same flag; first def wins.
        "-Wl,--allow-multiple-definition",
        "-ldl",
        "-lm",
        "-lz",
    ] + select({
        # Android's Bionic libc folds pthread and rt into libc itself — there
        # is no libpthread.so / librt.so, so `-lpthread`/`-lrt` make ld.lld
        # fail with "unable to find library". On the host (glibc) they are
        # separate libs and must be linked explicitly.
        ":android_build": [],
        "//conditions:default": [
            "-lpthread",
            "-lrt",
        ],
    }),
    deps = [
        ":c_engine_staging",
        ":c_engine_external",
        ":kissfft",
        # abseil providing the symbols excluded from the archive above.
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        # NOT absl/log:flags — it registers an abseil "minloglevel" flag that
        # collides with sentencepiece's gflags-style FLAGS_minloglevel (ODR).
        # litert_lm_main works precisely because it doesn't link log:flags.
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/log:die_if_null",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:cord",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@abseil-cpp//absl/hash",
        "@abseil-cpp//absl/random",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/container:node_hash_map",
        "@abseil-cpp//absl/container:btree",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/base",
        "@abseil-cpp//absl/base:log_severity",
        "@abseil-cpp//absl/debugging:symbolize",
        "@abseil-cpp//absl/debugging:failure_signal_handler",
        "@abseil-cpp//absl/debugging:stacktrace",
        "@abseil-cpp//absl/types:span",
        "@abseil-cpp//absl/types:optional",
    ],
)
