# examples/deep-search/env.example
#
# Copy to env.local (gitignored) and fill in real values. Then:
#   set -a; source env.local; set +a
#   bazel test //tests/integration:deep_search_e2e_test --test_output=all
#   bazel run //examples/deep-search:deep_search -- "your question"

# --- Tavily (required: powers tavily_search / tavily_extract) ---
TAVILY_API_KEY=tvly-YOUR_KEY_HERE

# --- Cloud LLM (OpenAI-compatible; required for cloud mode and the e2e test) ---
AGENTFLOW_LLM_BASE_URL=https://api.deepseek.com/v1
AGENTFLOW_LLM_MODEL=deepseek-chat
# Optional: omit entirely for keyless gateways (local Ollama/vLLM/LiteLLM)
AGENTFLOW_LLM_API_KEY=sk-YOUR_KEY_HERE

# Optional: CA bundle for https verification.
# Defaults to /etc/ssl/certs/ca-certificates.crt when unset.
# AGENTFLOW_LLM_CA_PATH=

# --- Local mode (wall-time comparison) ---
# When MODEL_PATH is set, the same workflow runs against the local
# LiteRT-LM engine instead of the cloud endpoint.
# MODEL_PATH=models/gemma-4-E2B-it.litertlm
